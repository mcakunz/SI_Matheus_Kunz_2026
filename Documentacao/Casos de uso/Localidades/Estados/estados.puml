@startuml Países - Casos de Uso

left to right direction

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #888780
    ActorBorderColor #0F6E56
    ActorBackgroundColor #E1F5EE
    ArrowColor #5F5E5A
    FontSize 12
}
skinparam packageStyle rectangle
skinparam packageBorderColor #9FE1CB
skinparam packageBackgroundColor #F5FDFB

actor "Usuário\nAutenticado" as User

package "Gerenciar Países" {
    usecase "Listar países"            as UC1
    usecase "Buscar país por nome"     as UC2
    usecase "Cadastrar novo país"      as UC3
    usecase "Editar país"              as UC4
    usecase "Ativar / inativar país"   as UC5
    usecase "Excluir país"             as UC6
}

User --> UC1
User --> UC2

UC1 <.. UC3 : <<extend>>
UC1 <.. UC4 : <<extend>>
UC1 <.. UC5 : <<extend>>
UC1 <.. UC6 : <<extend>>

@enduml
