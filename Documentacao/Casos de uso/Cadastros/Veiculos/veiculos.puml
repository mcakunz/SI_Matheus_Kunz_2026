@startuml Veículos - Casos de Uso

left to right direction

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #888780
    ActorBorderColor #0F6E56
    ActorBackgroundColor #E1F5EE
    ArrowColor #5F5E5A
    FontSize 12
}
skinparam packageStyle rectangle
skinparam packageBorderColor #9FE1CB
skinparam packageBackgroundColor #F5FDFB

actor "Usuário\nAutenticado" as User

package "Gerenciar Veículos" {
    usecase "Listar veículos"                as UC1
    usecase "Cadastrar novo veículo"         as UC2
    usecase "Editar veículo"                 as UC3
    usecase "Ativar / inativar veículo"      as UC4
    usecase "Excluir veículo"                as UC5
}

User --> UC1

UC1 <.. UC2 : <<extend>>
UC1 <.. UC3 : <<extend>>
UC1 <.. UC4 : <<extend>>
UC1 <.. UC5 : <<extend>>

@enduml
