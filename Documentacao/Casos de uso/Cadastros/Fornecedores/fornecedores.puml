@startuml Fornecedores - Casos de Uso

left to right direction

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #888780
    ActorBorderColor #0F6E56
    ActorBackgroundColor #E1F5EE
    ArrowColor #5F5E5A
    FontSize 12
}
skinparam packageStyle rectangle
skinparam packageBorderColor #9FE1CB
skinparam packageBackgroundColor #F5FDFB

actor "Usuário\nAutenticado" as User

package "Gerenciar Fornecedores" {
    usecase "Listar fornecedores"                    as UC1
    usecase "Cadastrar novo fornecedor"              as UC2
    usecase "Editar fornecedor"                      as UC3
    usecase "Ativar / inativar fornecedor"           as UC4
    usecase "Excluir fornecedor"                     as UC5
    usecase "Cadastrar novo país"                    as UC6
    usecase "Cadastrar novo estado"                  as UC7
    usecase "Cadastrar nova cidade"                  as UC8
    usecase "Cadastrar nova condição de pagamento"   as UC9
    usecase "Cadastrar nova transportadora"          as UC10
}

User --> UC1

UC1 <.. UC2 : <<extend>>
UC1 <.. UC3 : <<extend>>
UC1 <.. UC4 : <<extend>>
UC1 <.. UC5 : <<extend>>

UC2 <.. UC6  : <<extend>>
UC2 <.. UC7  : <<extend>>
UC2 <.. UC8  : <<extend>>
UC2 <.. UC9  : <<extend>>
UC2 <.. UC10 : <<extend>>

@enduml
