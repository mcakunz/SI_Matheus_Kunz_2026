@startuml Unidades de Medida - Casos de Uso

left to right direction

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #888780
    ActorBorderColor #0F6E56
    ActorBackgroundColor #E1F5EE
    ArrowColor #5F5E5A
    FontSize 12
}
skinparam packageStyle rectangle
skinparam packageBorderColor #9FE1CB
skinparam packageBackgroundColor #F5FDFB

actor "Usuário\nAutenticado" as User

package "Gerenciar Unidades de Medida" {
    usecase "Listar unidades de medida"                as UC1
    usecase "Cadastrar nova unidade de medida"          as UC2
    usecase "Editar unidade de medida"                 as UC3
    usecase "Ativar / inativar unidade de medida"      as UC4
    usecase "Excluir unidade de medida"                as UC5
}

User --> UC1

UC1 <.. UC2  : <<extend>>
UC1 <.. UC3  : <<extend>>
UC1 <.. UC4  : <<extend>>
UC1 <.. UC5  : <<extend>>

@enduml